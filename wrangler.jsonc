{
  // Static site: `npm run build` produces ./dist, Cloudflare serves it as static assets.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "hello-world",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
